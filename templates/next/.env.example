# Canonical site origin (no trailing slash)
SITE_URL=https://openblog.ai

# subdirectory | subdomain | standalone
DEPLOY_MODE=standalone

# Used when DEPLOY_MODE is subdirectory or standalone (default /blog)
# Leave empty for subdomain mode (blog lives at subdomain root)
BLOG_BASE_PATH=/blog

# Set when the blog app is mounted at example.com/blog via reverse proxy
# ASSET_PREFIX=/blog
